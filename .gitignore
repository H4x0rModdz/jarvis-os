*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Build artifacts
*.o
*.so
*.a
*.d
# `*.d` above was meant for Rust dep files but also swallows config-
# style directories (systemd drop-ins, /etc/pam.d/-shaped trees, etc.)
# in iso assets. Keep those tracked.
!**/*.service.d/
!**/*.service.d/**
!iso/assets/**/*.d/
!iso/assets/**/*.d/**

# Qt/CMake (shell/)
shell/*/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Env
.env
.env.local

