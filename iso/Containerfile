# syntax=docker/dockerfile:1.6
#
# Jarvis OS image build.
#
# Two stages:
#   1. `builder` — FROM the prebuilt jarvis-builder base (ADR 0021 P2),
#      which already carries the Fedora toolchain + Qt6 headers +
#      whisper-cli + piper + numbat under /out. This stage only
#      compiles OUR crates + the Qt shell.
#   2. Final  — Official Fedora bootc image (quay.io/fedora/fedora-bootc).
#      We layer labwc + greetd + Qt6 runtime + LayerShellQt + Ollama +
#      our compiled binaries + systemd units.
#
# The builder base is built by iso/Containerfile.builder (CI:
# build-builder.yml; local: tools/build-iso.sh builds it on demand
# when the image isn't present). BUILDER_IMAGE overrides the ref.
#
# Output is an OCI image for `bootc-image-builder` to turn into an
# ISO. See iso/README.md.

# ──────────────────────────── Stage 1: builder ────────────────────────────
ARG BUILDER_IMAGE=ghcr.io/h4x0rmoddz/jarvis-builder:latest
FROM ${BUILDER_IMAGE} AS builder

# Toggle to pull `jarvis-compositor` into the build. The builder base
# already ships the Smithay devel deps (libseat/libinput/mesa/libdrm),
# so this is purely a "do we compile + ship the binary" switch now —
# no extra dnf. See ADR 0006 + shell/compositor/module.md.
ARG BUILD_COMPOSITOR=0

# whisper / piper / numbat already live under /out in the builder base
# (iso/Containerfile.builder) — nothing to build here. We go straight
# to our own source.
WORKDIR /src
COPY . .

# Daemons only — we deliberately skip the compositor crate here. It's a
# stub for now and pulls in smithay + libseat-sys + a long tail of Wayland
# build deps that would balloon the ISO image. The ISO uses labwc as its
# compositor; our own lands in a later release.
# Cache mounts (build-speed, see ADR 0021): the cargo target dir +
# the cargo registry/git persist ACROSS builds without landing in any
# image layer. A source-only edit then recompiles just our crates —
# the whole dependency tree (tokio, zbus, reqwest, rusqlite, rustfft,
# …) stays warm. Local rebuilds drop from ~15 min to ~2 min.
#
# Because the target dir is a cache mount (gone once the RUN ends), we
# copy the binaries we want into the real /out tree IN THE SAME RUN —
# a later "collect" step can't read a cache mount.
RUN --mount=type=cache,target=/build/rust,id=jarvis-rust-target \
    --mount=type=cache,target=/root/.cargo/registry,id=cargo-registry \
    --mount=type=cache,target=/root/.cargo/git,id=cargo-git \
    CARGO_TARGET_DIR=/build/rust cargo build --release \
        -p jarvis-action-bus \
        -p jarvis-permission \
        -p jarvis-settings \
        -p jarvis-notifications \
        -p jarvis-lilith \
        -p jarvis-updater \
        -p jarvis-voice \
        -p jarvis-voice-ctl \
        -p jarvis-app \
        -p sdk-hello \
        -p jarvis-compat \
        -p jarvis-lock \
        -p jarvis-lock-ctl \
        -p jarvis-voiceprint-ctl \
        -p pam-jarvis \
    && mkdir -p /out/bin /out/pam \
    && cp /build/rust/release/jarvis-action-bus     /out/bin/ \
    && cp /build/rust/release/jarvis-permission     /out/bin/ \
    && cp /build/rust/release/jarvis-settings       /out/bin/ \
    && cp /build/rust/release/jarvis-notifications  /out/bin/ \
    && cp /build/rust/release/jarvis-lilith         /out/bin/ \
    && cp /build/rust/release/jarvis-updater        /out/bin/ \
    && cp /build/rust/release/jarvis-voice          /out/bin/ \
    && cp /build/rust/release/jarvis-voice-ctl      /out/bin/ \
    && cp /build/rust/release/jarvis-app            /out/bin/ \
    && cp /build/rust/release/sdk-hello             /out/bin/ \
    && cp /build/rust/release/jarvis-compat         /out/bin/ \
    && cp /build/rust/release/jarvis-lock           /out/bin/ \
    && cp /build/rust/release/jarvis-lock-ctl       /out/bin/ \
    && cp /build/rust/release/jarvis-voiceprint-ctl /out/bin/ \
    && cp /build/rust/release/libpam_jarvis.so      /out/pam/pam_jarvis.so \
    && cp /build/rust/release/jarvis-pam-helper     /out/bin/

# Optional: build the Jarvis Smithay compositor when BUILD_COMPOSITOR=1.
# Self-contained (both branches land /out/bin/jarvis-compositor) so the
# collect step below doesn't need to read the cache-mounted target dir.
# Shares the same cache mounts so the dep tree from above is reused.
RUN --mount=type=cache,target=/build/rust,id=jarvis-rust-target \
    --mount=type=cache,target=/root/.cargo/registry,id=cargo-registry \
    --mount=type=cache,target=/root/.cargo/git,id=cargo-git \
    mkdir -p /out/bin \
    && if [ "$BUILD_COMPOSITOR" = "1" ]; then \
           CARGO_TARGET_DIR=/build/rust cargo build --release \
               -p jarvis-compositor \
           && cp /build/rust/release/jarvis-compositor /out/bin/ \
           && strip /out/bin/jarvis-compositor; \
       else \
           printf '#!/bin/sh\necho "jarvis-compositor was not built into this image (BUILD_COMPOSITOR=0). See shell/compositor/module.md." >&2\nexit 127\n' \
               > /out/bin/jarvis-compositor \
           && chmod +x /out/bin/jarvis-compositor; \
       fi

# Qt shell — separate cmake build out-of-tree.
RUN cmake -S shell/jarvis-shell -B /build/shell -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build/shell -j

# Greeter — separate cmake build. Same Qt6 stack as the shell, but
# self-contained so it can run under cage as the unprivileged
# `greeter` user before the main session starts.
RUN cmake -S shell/jarvis-greeter -B /build/greeter -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build/greeter -j

# Lock window — third Qt project. Shares the branding qrc with the
# greeter, links LayerShellQt for the Overlay-layer + Exclusive
# keyboard window that gates the session during a lock.
RUN cmake -S shell/jarvis-lock -B /build/lock -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build/lock -j

# Collect the cmake outputs (the Rust binaries + pam + compositor are
# already in /out from their own cache-mounted RUNs above — those
# build dirs are cache mounts and can't be read here). The cmake
# /build/{lock,shell,greeter} dirs are ordinary layers, so they're
# readable. strip everything in /out/bin in one pass — picks up the
# Rust + compositor binaries that landed earlier too.
RUN cp /build/lock/jarvis-lock-window /out/bin/ \
    && cp /build/shell/jarvis-shell    /out/bin/ \
    && cp /build/greeter/jarvis-greeter /out/bin/ \
    # Per-file strip that tolerates non-ELF entries: when
    # BUILD_COMPOSITOR=0, /out/bin/jarvis-compositor is a shell-script
    # stub (created in the compositor RUN above), and `strip` on a
    # text file errors out "file format not recognized" and fails the
    # whole RUN. Skip anything strip can't handle.
    && for f in /out/bin/*; do strip "$f" 2>/dev/null || true; done

# ──────────────────────────── Stage 2: final  ────────────────────────────
FROM quay.io/fedora/fedora-bootc:42

ARG JARVIS_VERSION=0.0.1
# Repeat from stage 1 — Containerfile ARGs don't cross stages.
ARG BUILD_COMPOSITOR=0
LABEL org.opencontainers.image.title="Jarvis OS"
LABEL org.opencontainers.image.description="AI-native desktop OS, built on Fedora Atomic + labwc"
LABEL org.opencontainers.image.version="${JARVIS_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/H4x0rModdz/jarvis-os"

# Desktop runtime: labwc compositor, foot terminal (default keybind),
# greetd for autologin into the wayland session, Qt 6 + LayerShellQt for
# the shell, the usual user-facing helpers, and Ollama (no model baked in
# — the post-first-boot updater pulls the LLM weights).
RUN dnf -y install \
        labwc foot cage \
        greetd \
        xorg-x11-server-Xwayland \
        qt6-qtbase qt6-qtdeclarative qt6-qtwayland qt6-qtquickcontrols2 \
        layer-shell-qt \
        sqlite libnotify xdg-utils jq curl \
        seatd polkit NetworkManager \
        mesa-dri-drivers \
        wl-clipboard grim slurp \
        swayidle \
        wlr-randr \
        pulseaudio-utils \
        brightnessctl \
        playerctl \
        upower \
        bluez \
        alsa-lib \
        wine \
        flatpak \
        pamtester \
    && dnf clean all

# Flathub remote system-wide so `flatpak install --user flathub <id>`
# resolves on first call. Adding it at image build time keeps the
# first-boot path zero-config — Lilith can install Firefox before
# the user has typed anything else.
RUN flatpak remote-add --if-not-exists flathub \
        https://flathub.org/repo/flathub.flatpakrepo

# Pre-install Firefox so the first boot has a working browser even
# when the user hasn't connected to Wi-Fi yet. Adds ~200 MB to the
# image (Firefox + Freedesktop runtime) but makes "open the browser"
# work out of the box.
#
# --system installs into /var/lib/flatpak which is writable on bootc;
# --no-related skips pre-installing the locale extensions (they'd add
# another ~100 MB without much benefit on a pt-BR default).
# The .desktop file lands in /var/lib/flatpak/exports/share/applications,
# which is already in XDG_DATA_DIRS via iso/assets/launchers/jarvis-
# session-launch — so the launcher grid (Phase 3 polish) picks it up.
RUN flatpak install --system --noninteractive --no-related -y \
        flathub org.mozilla.firefox

# Pre-install Dolphin (KDE file manager). Phase 23 — closes the
# "where are my files?" gap. The user picked KDE's Dolphin over
# Nautilus + others; first install pulls in the KDE Platform
# runtime (~1 GB) which is the costly part. Future KDE apps reuse
# the runtime so they're tiny in comparison.
RUN flatpak install --system --noninteractive --no-related -y \
        flathub org.kde.dolphin

# Pre-install Zed (Rust-based code editor). Reuses the Freedesktop
# runtime Firefox already pulled, so marginal cost is ~150 MB. Same
# ecosystem (Rust) as our own daemons — keeps the "code editor"
# slot coherent with the rest of the stack instead of dragging in
# yet another runtime for a single app.
RUN flatpak install --system --noninteractive --no-related -y \
        flathub dev.zed.Zed

# System-wide MIME defaults — folders open in Dolphin, http(s)/html
# in Firefox. Drops into /etc/xdg/ so every user inherits without
# needing to maintain a per-user mimeapps.list.
COPY iso/assets/xdg/mimeapps.list /etc/xdg/mimeapps.list

# WhiteSur (macOS-like) GTK theme + icons + cursors, system-wide
# under /usr/share. Styles GTK apps (Firefox) + the icon set the
# launcher / file manager read + the pointer. Our own Qt shell keeps
# its glassmorphic design — the GTK theme doesn't touch it.
#
# Dolphin (Qt/KDE) is NOT styled by this — matching it needs the
# WhiteSur Kvantum theme + qt5ct/qt6ct wiring, deferred to a
# follow-up. git is only needed for the clone, so we install it,
# run the script, and the layer keeps the cloned repos out (the
# script cleans its tmp dir).
COPY iso/assets/theme/install-whitesur.sh /tmp/install-whitesur.sh
# git for the clones; sass + glib2 for the GTK4/libadwaita theme
# build (WhiteSur's install.sh compiles gtk4 CSS with sass and runs
# glib-compile-resources). Missing sass is the usual reason the
# install dies mid-run.
#
# The WhiteSur step is NON-FATAL: it's purely cosmetic, so a failure
# (network hiccup, OOM on the huge icon repo, upstream script change)
# logs a warning and ships the ISO without the theme rather than
# killing a 10-minute build. The gtk-settings.ini below names
# WhiteSur-Dark; if the theme is absent GTK silently falls back to
# its default, which is harmless.
RUN dnf -y install git sass glib2 \
    && ( bash /tmp/install-whitesur.sh \
         || echo "WARN: WhiteSur install failed — shipping without the theme" ) \
    && rm -f /tmp/install-whitesur.sh \
    && dnf -y remove git sass \
    && dnf clean all

# System-wide GTK defaults so GTK apps pick up WhiteSur + the icon
# theme + cursor without a per-user config file.
COPY iso/assets/theme/gtk-settings.ini /etc/gtk-3.0/settings.ini
COPY iso/assets/theme/gtk-settings.ini /etc/gtk-4.0/settings.ini

# Flatpak sandboxes don't see /usr/share/themes|icons and reset the
# environment, so the session launcher's GTK_THEME won't reach
# Firefox. A system-wide override grants read-only access to the
# host theme dirs + sets GTK_THEME inside the sandbox. Applies to
# every Flatpak (current + future), so Dolphin/Zed inherit the
# icon + cursor too even though their widget toolkits differ.
RUN flatpak override --system \
        --filesystem=/usr/share/themes:ro \
        --filesystem=/usr/share/icons:ro \
        --env=GTK_THEME=WhiteSur-Dark \
        --env=XCURSOR_THEME=WhiteSur-cursors

# `greeter` system user — owns nothing on disk, has no shell login,
# only exists for greetd to spawn jarvis-greeter under.
RUN useradd --system --shell /sbin/nologin --home-dir /var/lib/greeter \
            --create-home greeter

# whisper.cpp binary + the multilingual base model shipped in the
# builder stage. The model lives under /usr/share so it's part of the
# immutable layer; the daemon's `stt::DEFAULT_MODEL` constant points
# here. Replacement / upgrade flows are an updater Phase 2 concern.
COPY --from=builder /out/whisper/whisper-cli           /usr/bin/whisper-cli
COPY --from=builder /out/whisper-models/ggml-base.bin  /usr/share/whisper-models/ggml-base.bin

# numbat — Lilith's calculator backend (see #159). No .desktop —
# this is a tool the assistant reaches for, not an app the user
# opens directly. Built from crates.io in the builder stage.
COPY --from=builder /out/numbat/bin/numbat              /usr/bin/numbat

# piper (TTS) lives under /opt because the upstream tarball bundles its
# own libonnxruntime and espeak-ng-data alongside the binary — keeping
# them together keeps RPATH resolution simple. The /usr/bin/piper
# symlink is what `tts::DEFAULT_BINARY` resolves to. Voice models live
# under /usr/share like the whisper one.
COPY --from=builder /out/piper                          /opt/piper
COPY --from=builder /out/piper-voices                   /usr/share/piper-voices
RUN ln -sf /opt/piper/piper /usr/bin/piper

# Ollama. The upstream installer creates a system user with home
# `/usr/share/ollama`, which is read-only under bootc — the daemon then
# crash-loops trying to write `~/.ollama/id_ed25519`. We bolt on a drop-in
# that redirects HOME to /var/lib/ollama and asks systemd to provision that
# directory with the right ownership (StateDirectory= creates
# /var/lib/<name> chown ollama:ollama before ExecStart). We also enable the
# unit — the installer skips `systemctl enable` on bootc images.
RUN curl -fsSL https://ollama.com/install.sh | sh \
    && mkdir -p /etc/systemd/system/ollama.service.d \
    && printf '[Service]\nEnvironment=HOME=/var/lib/ollama\nStateDirectory=ollama\n' \
        > /etc/systemd/system/ollama.service.d/bootc-home.conf \
    && systemctl enable ollama.service

# Compiled binaries from the builder stage.
COPY --from=builder /out/bin/jarvis-action-bus    /usr/bin/jarvis-action-bus
COPY --from=builder /out/bin/jarvis-permission    /usr/bin/jarvis-permission
COPY --from=builder /out/bin/jarvis-settings      /usr/bin/jarvis-settings
COPY --from=builder /out/bin/jarvis-notifications /usr/bin/jarvis-notifications
COPY --from=builder /out/bin/jarvis-lilith        /usr/bin/jarvis-lilith
COPY --from=builder /out/bin/jarvis-updater       /usr/bin/jarvis-updater
COPY --from=builder /out/bin/jarvis-voice         /usr/bin/jarvis-voice
COPY --from=builder /out/bin/jarvis-voice-ctl     /usr/bin/jarvis-voice-ctl
COPY --from=builder /out/bin/jarvis-app           /usr/bin/jarvis-app
COPY --from=builder /out/bin/sdk-hello            /usr/bin/sdk-hello
COPY --from=builder /out/bin/jarvis-compat        /usr/bin/jarvis-compat
COPY --from=builder /out/bin/jarvis-lock          /usr/bin/jarvis-lock
COPY --from=builder /out/bin/jarvis-lock-ctl      /usr/bin/jarvis-lock-ctl
COPY --from=builder /out/bin/jarvis-voiceprint-ctl /usr/bin/jarvis-voiceprint-ctl
COPY --from=builder /out/bin/jarvis-lock-window   /usr/bin/jarvis-lock-window
COPY --from=builder /out/bin/jarvis-shell         /usr/bin/jarvis-shell
COPY --from=builder /out/bin/jarvis-greeter       /usr/bin/jarvis-greeter

# Optional Jarvis compositor binary. The stub-or-real selection is
# done in stage 1; here we always install runtime libs when
# BUILD_COMPOSITOR=1 so the real binary has what it needs, then COPY
# the file regardless (stub if not built — see stage 1 fallback).
RUN if [ "$BUILD_COMPOSITOR" = "1" ]; then \
        dnf -y install libseat libinput mesa-libgbm mesa-libEGL libdrm \
        && dnf clean all; \
    fi
COPY --from=builder /out/bin/jarvis-compositor /usr/bin/jarvis-compositor

# pam_jarvis.so — biometric PAM module. V2 (ADR 0019) shells out to
# /usr/libexec/jarvis-pam-helper to keep the tokio/zbus stack out of
# every sudo/login.
COPY --from=builder /out/pam/pam_jarvis.so        /usr/lib64/security/pam_jarvis.so
COPY --from=builder /out/bin/jarvis-pam-helper    /usr/libexec/jarvis-pam-helper

# Dual PAM stacks for jarvis-lock (ADR 0020, Phase 8 split):
#   /etc/pam.d/jarvis-lock        — password-only, fast path
#   /etc/pam.d/jarvis-lock-voice  — voiceprint required, no password
# Lock daemon routes by entry point (`Verify` → password file,
# `VerifyVoice` → voice file) so typed unlocks are instant and the
# voice path is opt-in per attempt.
COPY iso/assets/pam.d/jarvis-lock                 /etc/pam.d/jarvis-lock
COPY iso/assets/pam.d/jarvis-lock-voice           /etc/pam.d/jarvis-lock-voice

# Example SDK app: ship its manifest under /usr/share/jarvis/apps/
# so the Action Bus picks it up at startup. DBus auto-activation is
# wired through `/usr/share/dbus-1/services/com.jarvis.app.sdk_hello.service`
# below so the first call to sdk_hello.echo / sdk_hello.add summons
# the binary even when it isn't already running.
COPY examples/sdk-hello/manifest.toml \
     /usr/share/jarvis/apps/sdk_hello/manifest.toml
RUN mkdir -p /usr/share/dbus-1/services \
    && printf '[D-BUS Service]\nName=com.jarvis.app.sdk_hello\nExec=/usr/bin/sdk-hello\n' \
        > /usr/share/dbus-1/services/com.jarvis.app.sdk_hello.service

# .desktop file so the example app shows up in the launcher grid like
# any other installed application. Demonstrates that an SDK app is a
# first-class citizen, not just an invisible DBus name.
COPY examples/sdk-hello/jarvis-sdk-hello.desktop \
     /usr/share/applications/jarvis-sdk-hello.desktop

# systemd user units for the daemons. `jarvis-session.target` depends on
# the four core services and binds to `graphical-session.target` so they
# spin up when labwc starts. The updater is `Wants=` (advisory) — the rest
# of the session works even if it fails to come up.
COPY iso/assets/systemd/jarvis-permission.service    /etc/systemd/user/
COPY iso/assets/systemd/jarvis-settings.service      /etc/systemd/user/
COPY iso/assets/systemd/jarvis-notifications.service /etc/systemd/user/
COPY iso/assets/systemd/jarvis-action-bus.service    /etc/systemd/user/
COPY iso/assets/systemd/jarvis-lilith.service        /etc/systemd/user/
COPY iso/assets/systemd/jarvis-updater.service       /etc/systemd/user/
COPY iso/assets/systemd/jarvis-voice.service         /etc/systemd/user/
COPY iso/assets/systemd/jarvis-compat.service        /etc/systemd/user/
COPY iso/assets/systemd/jarvis-lock.service          /etc/systemd/user/
COPY iso/assets/systemd/jarvis-session.target        /etc/systemd/user/
RUN systemctl --global enable jarvis-session.target

# Hardware-key handlers — small shell scripts under
# /usr/libexec/jarvis-keys/ that wrap pactl / brightnessctl /
# playerctl + post a replaces_id notification for OSD-style
# feedback. labwc rc.xml binds the XF86 keysyms to them.
COPY iso/assets/keys/ /usr/libexec/jarvis-keys/
RUN chmod 0755 /usr/libexec/jarvis-keys/*

# logind policy: suspend on lid close even when on AC (default lets
# the laptop keep running plugged in, which conflicts with the
# "close it and walk away" expectation). Idle-action is left to
# swayidle + the lock daemon (Phase 5) so we don't get a duplicate
# suspend stack.
COPY iso/assets/systemd/logind.conf.d/jarvis.conf \
     /etc/systemd/logind.conf.d/jarvis.conf

# Session launcher: a 30-line shell script that probes the host and
# picks WLR_RENDERER before exec'ing whatever it's wrapping. Real GPUs
# get the default GPU path; VirtualBox VMSVGA falls back to pixman so
# the compositor doesn't die on dmabuf import. greetd uses it for the
# cage+greeter side, the greeter sends it as the labwc command in
# start_session — symmetric on both sides of login.
COPY iso/assets/launchers/jarvis-session-launch /usr/libexec/jarvis-session-launch
RUN chmod 0755 /usr/libexec/jarvis-session-launch

# greetd: autologin as `jarvis` and exec labwc through the wrapper.
# Anaconda creates the user from build.toml so the name matches at
# install time.
COPY iso/assets/greetd/config.toml /etc/greetd/config.toml
RUN systemctl enable greetd.service \
    && systemctl set-default graphical.target

# labwc skeleton: every newly-created user inherits this autostart and
# config from /etc/skel.
RUN mkdir -p /etc/skel/.config/labwc
COPY iso/assets/labwc/autostart    /etc/skel/.config/labwc/autostart
COPY iso/assets/labwc/rc.xml       /etc/skel/.config/labwc/rc.xml
COPY iso/assets/labwc/environment  /etc/skel/.config/labwc/environment

# Default filesystem for the installed system. Without this, bootc-image-
# builder refuses to build an ISO and demands `--rootfs <fs>` on the
# command line. Btrfs matches what Silverblue/Kinoite use and gives us
# subvolumes/snapshots for free.
RUN mkdir -p /usr/lib/bootc/install \
    && printf '[install]\n[install.filesystem.root]\ntype = "btrfs"\n' \
        > /usr/lib/bootc/install/00-default.toml

# bootc lint catches the usual boot-config mistakes (kernel cmdline,
# /etc vs /usr placement, sysctl drop-ins).
RUN bootc container lint
