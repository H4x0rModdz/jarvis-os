# syntax=docker/dockerfile:1.6
#
# Jarvis OS image build.
#
# Two stages:
#   1. `builder` — Fedora 42 with Rust + Qt 6.8 + LayerShellQt headers.
#      Compiles every Jarvis daemon and the Qt shell from this repo.
#   2. Final  — Universal Blue's `wayblue-labwc` (Fedora bootc Atomic with
#      labwc as the compositor) plus our binaries, systemd user services,
#      labwc autostart, and an `ollama` install so the post-first-boot
#      updater can pull the LLM weights.
#
# Output of this build is an OCI image suitable for `bootc-image-builder`
# to convert into a bootable ISO. See iso/README.md.

# ──────────────────────────── Stage 1: builder ────────────────────────────
FROM registry.fedoraproject.org/fedora:42 AS builder

RUN dnf -y install \
        rust cargo \
        cmake ninja-build clang gcc-c++ make \
        qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qtwayland-devel \
        qt6-qtbase-private-devel qt6-qtdeclarative-private-devel \
        kf6-layer-shell-qt-devel \
        sqlite-devel \
        dbus-devel pkgconfig \
        wayland-devel libxkbcommon-devel \
        git \
    && dnf clean all

WORKDIR /src
COPY . .

# Rust workspace — every daemon ships as a release binary.
RUN CARGO_TARGET_DIR=/build/rust cargo build --release --workspace -p jarvis-action-bus -p jarvis-permission -p jarvis-lilith

# Qt shell — separate cmake build out-of-tree.
RUN cmake -S shell/jarvis-shell -B /build/shell -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build/shell -j

# Collect everything that ends up on the final image.
RUN mkdir -p /out/bin \
    && cp /build/rust/release/jarvis-action-bus  /out/bin/ \
    && cp /build/rust/release/jarvis-permission  /out/bin/ \
    && cp /build/rust/release/jarvis-lilith      /out/bin/ \
    && cp /build/shell/jarvis-shell              /out/bin/ \
    && strip /out/bin/*

# ──────────────────────────── Stage 2: final  ────────────────────────────
FROM ghcr.io/ublue-os/wayblue-labwc:latest

ARG JARVIS_VERSION=0.0.1
LABEL org.opencontainers.image.title="Jarvis OS"
LABEL org.opencontainers.image.description="AI-native desktop OS, built on Fedora Atomic + labwc"
LABEL org.opencontainers.image.version="${JARVIS_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/H4x0rModdz/jarvis-os"

# Runtime deps that wayblue-labwc may not already include. Idempotent —
# rpm-ostree just skips what's there. The kf6-layer-shell-qt runtime is
# what enables our wlr-layer-shell anchoring.
RUN rpm-ostree install \
        qt6-qtbase qt6-qtdeclarative qt6-qtwayland qt6-qtquickcontrols2 \
        kf6-layer-shell-qt \
        sqlite \
        libnotify \
        xdg-utils \
        jq \
    && rpm-ostree cleanup -m \
    && ostree container commit

# Ollama for the AI runtime. We pre-install the daemon and CLI but do NOT
# download any model — the post-first-boot updater handles that so the ISO
# stays slim.
RUN curl -fsSL https://ollama.com/install.sh | sh \
    && ostree container commit

# Drop our compiled binaries onto the rootfs.
COPY --from=builder /out/bin/jarvis-action-bus  /usr/bin/jarvis-action-bus
COPY --from=builder /out/bin/jarvis-permission  /usr/bin/jarvis-permission
COPY --from=builder /out/bin/jarvis-lilith      /usr/bin/jarvis-lilith
COPY --from=builder /out/bin/jarvis-shell       /usr/bin/jarvis-shell

# systemd user units for the daemons + a target that depends on all three.
# Enabling `jarvis-session.target` for graphical-session.target wakes them
# up when the user logs in to labwc.
COPY iso/assets/systemd/jarvis-permission.service /etc/systemd/user/
COPY iso/assets/systemd/jarvis-action-bus.service /etc/systemd/user/
COPY iso/assets/systemd/jarvis-lilith.service     /etc/systemd/user/
COPY iso/assets/systemd/jarvis-session.target     /etc/systemd/user/
RUN systemctl --global enable jarvis-session.target

# labwc autostart + theme. Anything written under /etc/skel ends up in
# every new user's home on first login.
RUN mkdir -p /etc/skel/.config/labwc
COPY iso/assets/labwc/autostart /etc/skel/.config/labwc/autostart
COPY iso/assets/labwc/rc.xml    /etc/skel/.config/labwc/rc.xml

# Final OSTree commit so the image is a clean bootc-compatible layer.
RUN ostree container commit
