[Unit]
Description=Jarvis Settings (user)
Documentation=https://github.com/H4x0rModdz/jarvis-os
After=dbus.socket
PartOf=jarvis-session.target

[Service]
Type=dbus
BusName=com.jarvis.Settings
ExecStart=/usr/bin/jarvis-settings
Restart=on-failure
RestartSec=2

[Install]
WantedBy=jarvis-session.target
