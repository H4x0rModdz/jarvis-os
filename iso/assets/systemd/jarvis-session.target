[Unit]
Description=LilithOS user session
Documentation=https://github.com/H4x0rModdz/jarvis-os
Requires=jarvis-permission.service jarvis-settings.service jarvis-notifications.service jarvis-action-bus.service jarvis-lilith.service
# Updater and Voice are advisory — if either fails to come up the rest
# of the session still works (Lilith chat stays text-only, the shell
# shows a disabled mic + no updater splash). `Wants=` instead of
# `Requires=`.
Wants=jarvis-updater.service jarvis-voice.service jarvis-compat.service jarvis-lock.service
After=jarvis-permission.service jarvis-settings.service jarvis-notifications.service jarvis-action-bus.service jarvis-lilith.service

# `BindsTo=graphical-session.target` used to live here on the assumption
# that whichever DE the user picked would emit graphical-session.target
# (GNOME / KDE do). labwc does not, and trying to BindsTo a target that
# never exists makes systemd refuse the start with a misleading
# "Access denied" reply. Our session is driven explicitly by the labwc
# autostart, which runs `systemctl --user start jarvis-session.target`
# at the right moment — no implicit binding required.

[Install]
WantedBy=default.target
