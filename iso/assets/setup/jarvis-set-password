#!/usr/bin/env bash
# Set the password for the fixed `jarvis` account from stdin.
#
# Invoked as root via pkexec by the first-boot wizard (PowerBridge.
# setLoginPassword -> pkexec /usr/libexec/jarvis-set-password). Authorised
# without a prompt for wheel members by iso/assets/polkit/50-jarvis-setpw.rules
# — the same pattern the updater uses for `bootc` (49-jarvis-bootc.rules).
#
# The new password is read from STDIN (never argv — argv is visible in `ps`).
# The target user is hardcoded to `jarvis` so this helper can never be used to
# rewrite another account's password, even if the polkit rule widened.
set -uo pipefail

USER_NAME="jarvis"

IFS= read -r NEWPASS || true
if [ -z "${NEWPASS:-}" ]; then
    echo "jarvis-set-password: empty password on stdin" >&2
    exit 2
fi

# chpasswd splits on the FIRST colon, so colons inside the password are safe.
printf '%s:%s\n' "$USER_NAME" "$NEWPASS" | chpasswd
