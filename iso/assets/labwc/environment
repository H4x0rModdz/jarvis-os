# Environment variables labwc exports before starting the session.
#
# WLR_RENDERER=pixman           Force wlroots' CPU renderer. Required inside
#                               VMs without GPU passthrough (VirtualBox,
#                               Hyper-V, QEMU without GL); harmless on bare
#                               metal — Phase 2 swap to gles2 once we ship
#                               our own compositor with proper GPU detection.
# LIBGL_ALWAYS_SOFTWARE=1       Mesa fallback for any GL app run inside the
#                               session.
# WLR_NO_HARDWARE_CURSORS=1     VBox's SVGA driver mishandles HW cursors
#                               under wlroots — software cursor is fine.
# WLR_DRM_NO_ATOMIC=1           VMware's vmwgfx DRM rejects atomic page-flips/
#                               modesets — wlroots spams "atomic.c: Atomic
#                               commit failed: Device or resource busy" and
#                               the display flickers/stalls. Force the legacy
#                               (non-atomic) modesetting path, which vmwgfx
#                               handles reliably. Independent of the renderer
#                               (that's pixman above) — this is the KMS path.
#                               Legacy modeset works on every backend, so it's
#                               safe on bare metal / other hypervisors too.
# QT_IM_MODULE=none             No input-method framework in this session. With
#                               the Fedora default (ibus/xim) the IM layer
#                               swallowed control keys like Escape before they
#                               reached the focused widget — typing worked but
#                               Esc didn't close the launcher/panels. Disabling
#                               it lets Escape through. Confirmed on-device.
# QT_LOGGING_RULES …            Silences the noisy "Try to disable surface"
#                               warnings Qt's Wayland text-input v3 plugin
#                               emits every time a popup or dialog opens
#                               and steals focus from the bar's input. The
#                               protocol's focus model and Qt Quick's
#                               surface-per-Window model disagree — Qt
#                               recovers, but only after spamming stderr.
# XDG_CURRENT_DESKTOP            Identifies the session to xdg-desktop-portal
#                               (selects labwc-portals.conf → wlr ScreenCast +
#                               gtk FileChooser, ADR 0026) and to apps that
#                               branch on the desktop name.
WLR_RENDERER=pixman
LIBGL_ALWAYS_SOFTWARE=1
WLR_NO_HARDWARE_CURSORS=1
WLR_DRM_NO_ATOMIC=1
QT_IM_MODULE=none
QT_LOGGING_RULES=qt.qpa.wayland.textinput.warning=false
XDG_CURRENT_DESKTOP=labwc:wlroots
