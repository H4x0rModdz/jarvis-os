#!/bin/sh
# /usr/libexec/jarvis-session-launch — pick a wlroots renderer and exec
# the given command. Used in two places:
#
#   - greetd's command spawns cage through this so the login screen
#     gets the right renderer.
#   - The greeter sends this script (not labwc directly) as the
#     start_session command, so the user session inherits the same
#     decision.
#
# Default path is "do nothing" — wlroots picks EGL/GLES2, the GPU does
# its job. We only override to pixman (CPU rendering) when we know the
# host can't drive EGL safely:
#
#   1. VirtualBox VMSVGA. With 3D enabled, EGL init succeeds but
#      runtime dmabuf import fails and takes the compositor down.
#   2. VMware Workstation / Fusion. Same dmabuf import failure on
#      the vmwgfx + virgl path — wlroots tries to import a dmabuf
#      buffer and gets `error 7: importing the supplied dmabufs
#      failed` at runtime. Repro'd on Workstation 17 nested under
#      Hyper-V + on Fusion native; the pixman fallback sidesteps it.
#   3. No /dev/dri/renderD128. No DRM render node means no EGL path.
#
# Real hardware + Hyper-V GPU-P + QEMU virtio-gpu fall through to
# the GPU path untouched.

set -eu

# Everything software-rendering-related is set HERE and only here, gated on the
# host checks below. It used to be hardcoded in /etc/xdg/labwc/environment,
# which applied it unconditionally and silently pinned real hardware (an RTX
# 3060 desktop) to CPU rendering — compositor and every Qt window — no matter
# what this script decided.
force_pixman() {
    export WLR_RENDERER=pixman
    export WLR_NO_HARDWARE_CURSORS=1
    # Mesa fallback for GL apps run inside a session whose host can't drive
    # EGL — without it they try the hardware path and fail at runtime.
    export LIBGL_ALWAYS_SOFTWARE=1
    # VMware's vmwgfx DRM rejects atomic page-flips/modesets: wlroots spams
    # "Atomic commit failed: Device or resource busy" and the display
    # flickers/stalls. Force the legacy modesetting path it handles reliably.
    export WLR_DRM_NO_ATOMIC=1
}

if [ -r /sys/class/dmi/id/sys_vendor ]; then
    case "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)" in
        *VirtualBox*|*Oracle*|innotek*|VMware*)
            force_pixman
            ;;
    esac
fi

if [ -z "${WLR_RENDERER-}" ] && [ ! -e /dev/dri/renderD128 ]; then
    force_pixman
fi

# NVIDIA proprietary driver in use (ADR 0032). Desktops built on GNOME/KDE need
# nothing here — those compositors handle NVIDIA themselves, which is why
# Bazzite's NVIDIA config is only power management. wlroots does NOT: without
# these it either fails to pick the NVIDIA GBM backend or runs with an invisible
# cursor, the single most-reported wlroots-on-NVIDIA symptom.
#
# Gated on nvidia_drm actually being loaded, so an AMD/Intel box or a VM never
# sees them. That gate is the whole point: hardcoding these for every host is
# exactly the mistake the labwc `environment` file made with pixman.
if [ -d /sys/module/nvidia_drm ]; then
    # Tell Mesa/EGL to use NVIDIA's GBM implementation rather than the Mesa one.
    export GBM_BACKEND=nvidia-drm
    # Route GLX through NVIDIA's vendor library (libglvnd dispatch).
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    # NVIDIA dGPUs can only scan out surfaces already in video memory, so
    # wlroots' hardware cursor path yields an invisible cursor. Software cursor
    # is the standard workaround and costs nothing perceptible.
    export WLR_NO_HARDWARE_CURSORS=1
    # Hardware video decode (VA-API) through NVIDIA rather than Mesa's driver —
    # this is what keeps video playback off the CPU in Firefox and friends.
    export LIBVA_DRIVER_NAME=nvidia

    # NEXT LEVER IF THE DISPLAY FLICKERS OR TEARS: wlroots can render through
    # Vulkan instead of GLES2, and NVIDIA's Vulkan is its strongest path — the
    # wlroots-on-NVIDIA guides set it for exactly this. Left OFF by default
    # because we cannot test it here and a renderer that fails to initialise
    # means no desktop at all, which is a worse failure than imperfect output.
    # To try it, uncomment; to undo, `sudo bootc rollback`.
    #export WLR_RENDERER=vulkan
fi

# Flatpak exports its `.desktop` files outside XDG_DATA_DIRS' defaults,
# which means QStandardPaths::ApplicationsLocation (and therefore the
# launcher's app grid) doesn't see Flatpak apps unless we prepend them
# explicitly. The system-wide export dir is always there; the per-user
# one only exists once the user has installed at least one Flatpak.
xdg_flatpak="/var/lib/flatpak/exports/share"
if [ -n "${HOME-}" ]; then
    xdg_flatpak="${HOME}/.local/share/flatpak/exports/share:${xdg_flatpak}"
fi
if [ -n "${XDG_DATA_DIRS-}" ]; then
    export XDG_DATA_DIRS="${xdg_flatpak}:${XDG_DATA_DIRS}"
else
    export XDG_DATA_DIRS="${xdg_flatpak}:/usr/local/share:/usr/share"
fi

# WhiteSur look (Phase: WhiteSur). The cursor theme is honoured by
# labwc + every Wayland client through XCURSOR_*; GTK_THEME +
# the icon theme cover GTK apps that don't read /etc/gtk-*/settings
# .ini (Flatpak sandboxes in particular). Our Qt shell ignores
# GTK_THEME — it has its own design — but inherits the cursor.
export XCURSOR_THEME="${XCURSOR_THEME:-WhiteSur-cursors}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export GTK_THEME="${GTK_THEME:-WhiteSur-Dark}"

exec "$@"
