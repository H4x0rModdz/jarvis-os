# /etc/jarvis/session.env — per-machine overrides for the LilithOS session.
#
# Read by /usr/libexec/jarvis-session-launch just before it starts the
# compositor (and the login screen). Plain KEY=VALUE lines, no quotes, no
# `export`; anything else is ignored. Values here win over the launcher's own
# hardware detection. Takes effect at the next login.
#
# This file lives in /etc, so your edits survive system updates.
# Everything below is commented out: the defaults are what the launcher
# detects. Uncomment a line to try it; comment it again to undo.

# ── Compositor rendering ────────────────────────────────────────────────
# Render the compositor through Vulkan instead of OpenGL ES. Often the fix
# for flicker or tearing on NVIDIA. If the desktop does not come up with it,
# log in on a text console (Ctrl+Alt+F3) and comment it out again.
#WLR_RENDERER=vulkan

# On NVIDIA the launcher draws the mouse cursor in software, because older
# driver/wlroots combinations showed no cursor at all otherwise. A software
# cursor is redrawn by the compositor on every mouse movement; if the pointer
# itself feels laggy, try the hardware cursor:
#WLR_NO_HARDWARE_CURSORS=0

# ── Shell (top bar, dock, desktop HUD) ──────────────────────────────────
# Load only some of the shell's surfaces — for telling which one a
# performance problem belongs to. Default is all three.
#JARVIS_SHELL_SURFACES=topbar,dock

# Draw every shell window from one thread, in turn, instead of one render
# thread per window. Slower in theory, but immune to one window's frame
# pacing holding up the others.
#QSG_RENDER_LOOP=basic
