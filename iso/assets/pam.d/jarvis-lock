#%PAM-1.0
# Jarvis OS lock-screen — password-only path.
#
# Phase 7 wired pam_jarvis.so here as `sufficient`, but the voice
# attempt added ~2.5 s of latency to every typed-password unlock
# (ADR 0020). Phase 8 splits the stacks: this file stays password-
# only, and `jarvis-lock-voice` is the new voice-path. The daemon
# routes by entry point (`Verify` → here, `VerifyVoice` → there) so
# the user pays the voice latency only when they actively pick the
# voice button.

auth        include      system-auth
account     include      system-auth
password    include      system-auth
session     include      system-auth
