# syntax=docker/dockerfile:1.6
#
# LilithOS RUNTIME base image (ADR 0021 P2 — runtime half).
#
# The heavy, slow-changing half of the FINAL bootc image: the Fedora
# desktop runtime (labwc/Qt6/PipeWire/CUPS/...), the pre-installed
# Flatpak apps (Firefox + Dolphin + Zed + their runtimes, ~2.5 GB), the
# WhiteSur theme, and Ollama. NONE of it depends on OUR source — it only
# changes when we add a package / app / bump the theme.
#
# Build + push it RARELY (CI: .github/workflows/build-runtime.yml; local:
# tools/build-iso.sh builds it on demand when missing) to
# ghcr.io/<org>/jarvis-runtime. The main iso/Containerfile then does
# `FROM ghcr.io/<org>/jarvis-runtime` for its final stage and only layers
# our compiled binaries + configs on top — dropping the ~30 min of dnf +
# Flatpak + theme work off every per-merge build.
#
# Rebuild this image when:
#   - adding/removing a dnf package or a Flatpak app
#   - bumping the WhiteSur theme or its install script
#   - changing the portal / mimeapps / gtk / flatpak-override / sysctl assets
#     baked below
#
# It stays a valid bootc base (FROM fedora-bootc), so the final image
# layered on top remains OTA- and ISO-buildable.

# Base images, pinned by digest (ADR 0033). A tag like `:44` is whatever was
# pushed most recently, so an unpinned build silently changes kernel, Mesa and
# driver underneath us. Pinned, a base refresh is a reviewed one-line diff.
#
# The two MUST move together — the NVIDIA module is built for one exact kernel
# (checked below) — so never edit these by hand: run `tools/bump-base.sh`,
# which resolves both tags, confirms the kernels match and rewrites the lines.
# .github/workflows/bump-base.yml does that weekly and opens a PR.
#
# kernel: 7.3.4-200.fc44.x86_64   nvidia: 620.73.04   resolved: 2026-11-23
ARG FEDORA_BOOTC=quay.io/fedora/fedora-bootc@sha256:fb4c6080cacdd463079f862ec3523f6b16d90f6344b4bb6052fef35eede43aa9
ARG UBLUE_NVIDIA=ghcr.io/ublue-os/akmods-nvidia-open@sha256:b243c085eab75e5c074ab8c9211ce59dc748bc06035c4fda3663aadc0206afb7

# Prebuilt, signed NVIDIA kernel module + matching driver RPMs. Only mounted
# into the NVIDIA step further down; nothing from this stage is copied wholesale.
FROM ${UBLUE_NVIDIA} AS nvidia-rpms

FROM ${FEDORA_BOOTC}

# Desktop runtime: labwc compositor, foot terminal (default keybind),
# greetd for autologin into the wayland session, Qt 6 + LayerShellQt for
# the shell, the usual user-facing helpers, and Ollama (no model baked in
# — the post-first-boot updater pulls the LLM weights).
RUN dnf -y install \
        labwc foot cage \
        greetd \
        xorg-x11-server-Xwayland \
        qt6-qtbase qt6-qtdeclarative qt6-qtwayland qt6-qtquickcontrols2 \
        qt6-qtquick3d \
        layer-shell-qt \
        rsms-inter-fonts \
        sqlite libnotify xdg-utils xdg-user-dirs jq curl \
        seatd polkit lxqt-policykit NetworkManager \
        mesa-dri-drivers \
        wl-clipboard grim slurp \
        wtype \
        swayidle \
        swaybg \
        glib2 \
        wlr-randr \
        pulseaudio-utils \
        brightnessctl \
        playerctl \
        upower \
        bluez \
        alsa-lib \
        wine \
        flatpak \
        pamtester \
        open-vm-tools \
        qemu-guest-agent \
    && dnf clean all

# ── Wi-Fi and Bluetooth that actually work ──────────────────────────────
# `NetworkManager` alone cannot do Wi-Fi: the wireless support is a separate
# plugin package, it needs wpa_supplicant to authenticate, and Intel adapters
# (the most common ones in laptops and desktop boards) need iwlwifi firmware
# that the minimal fedora-bootc base leaves out. Without these the Wi-Fi
# panel had nothing to talk to — no adapter ever appeared, on any machine.
# wireless-regdb carries the per-country channel/power rules.
#
# bluez was installed but nothing guaranteed its service was enabled, so
# `bluetoothctl` could find no controller. Enable it explicitly; it is
# D-Bus/udev-driven and idle on machines without a Bluetooth radio.
RUN dnf -y install \
        NetworkManager-wifi wpa_supplicant wireless-regdb \
        iwlwifi-mvm-firmware iwlwifi-dvm-firmware iwlegacy-firmware \
        brcmfmac-firmware \
    && dnf clean all \
    && systemctl enable bluetooth.service

# ── Hyprland (ADR 0036) ─────────────────────────────────────────────────
# The session's compositor: window animations, real backdrop blur behind the
# shell's glass, rounded windows. labwc (installed above) stays as the
# fallback for hosts without a GPU — see /usr/libexec/jarvis-session-compositor.
#
# Fedora does not package Hyprland; this comes from a COPR, i.e. a
# third-party repository maintained by one person. That is a real dependency
# risk (ADR 0036 spells it out) and the reason the repo is disabled again
# right after the install: nothing else in the image may be pulled from it,
# and a later `dnf` step cannot pick up a surprise Hyprland update.
#   hyprland-plugin-hyprbars       title bars + buttons (Hyprland draws none)
#   xdg-desktop-portal-hyprland    screen sharing / screenshots on Hyprland
RUN dnf -y install dnf5-plugins \
    && dnf -y copr enable sdegler/hyprland \
    && dnf -y install hyprland hyprland-plugin-hyprbars xdg-desktop-portal-hyprland \
    && dnf -y copr disable sdegler/hyprland \
    && Hyprland --version | head -n 1 \
    && test -f /usr/lib64/hyprland/libhyprbars.so \
    && dnf clean all

# ── GPU acceleration ────────────────────────────────────────────────────
# Without these the desktop silently SOFTWARE-renders: Mesa falls back to
# llvmpipe and the whole shell — the HUD, the glass panels, every Qt window —
# is drawn on the CPU. Observed on real hardware: an RTX 3060 correctly bound
# to nouveau still reported `OpenGL renderer string: llvmpipe`, and opening any
# Qt panel lagged. `mesa-dri-drivers` alone is not enough:
#
#   * <vendor>-gpu-firmware — nouveau needs NVIDIA's signed GSP firmware to
#     bring up the engines on Turing and newer at all; AMD and Intel need
#     theirs for the same reason. fedora-bootc does not pull these in, so any
#     machine with a discrete GPU quietly lands on llvmpipe.
#   * mesa-vulkan-drivers — ships NVK. Since Mesa 25.1 the OpenGL path for
#     Turing+ is NVK + Zink; with no Vulkan driver installed there is nothing
#     for Zink to sit on, so GL falls to llvmpipe even once firmware loads.
#
# All of it is open source and redistributable (Fedora main repo) — no RPM
# Fusion, no proprietary blob.
RUN dnf -y install \
        mesa-vulkan-drivers \
        nvidia-gpu-firmware \
        amd-gpu-firmware \
        intel-gpu-firmware \
    && dnf clean all

# ── NVIDIA driver (ADR 0032, as amended by ADR 0033) ────────────────────
# The open stack does not deliver working OpenGL on Ampere here: Vulkan/NVK
# drives the GPU fine, but GL still lands on llvmpipe (Accelerated: no), and
# forcing Zink lands it on lavapipe — software Vulkan. It also has no CUDA,
# which we want for running Lilith's models on the GPU.
#
# The kernel module is NOT compiled here any more. It comes prebuilt and
# SIGNED from Universal Blue's akmods image (the `nvidia-rpms` stage above),
# together with the matching userspace driver and their install script — the
# same artifacts Bazzite, Bluefin and Aurora ship. That fixes the two real
# problems of building it ourselves with akmods:
#
#   * Secure Boot. Our module was unsigned, so it could not load with Secure
#     Boot on. Theirs is signed with the "ublue kernel" key; a user enrols
#     the public certificate once (see below) and the driver loads.
#   * The kernel-devel pin. akmods needs kernel-devel for EXACTLY the kernel
#     in the image, and Fedora's repos only keep the newest one — so the build
#     broke whenever the base's kernel was a few days old. Nothing is compiled
#     now, so nothing needs kernel-devel.
#
# What makes a prebuilt module safe is the check below: the module is built
# for one exact kernel, and both images are pinned by digest, so "the kernel
# in this image is the kernel that module was built for" is verified at build
# time and fails loudly instead of producing an image whose GPU driver
# silently refuses to load. Universal Blue's `main` kernel is Fedora's own
# kernel build (same vmlinuz, plus their signature), which is why our stock
# kernel can load it.
#
# MULTILIB=0: no 32-bit driver libraries (parity with what we shipped before).
# IMAGE_NAME is only read by the script to pick desktop-specific extras.
# dnf5-plugins: their script drives repos with `dnf5 config-manager`, which the
# minimal fedora-bootc base does not include.
RUN --mount=type=bind,from=nvidia-rpms,source=/rpms,target=/tmp/akmods-rpms \
    . /tmp/akmods-rpms/kmods/nvidia-vars \
    && BASE_KERNEL=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core | tail -1) \
    && if [ "${BASE_KERNEL}" != "${KERNEL_VERSION}" ]; then \
         echo "ERROR: fedora-bootc ships kernel ${BASE_KERNEL} but the NVIDIA module was built for ${KERNEL_VERSION}." ; \
         echo "       The two pinned digests are out of step — run tools/bump-base.sh." ; \
         exit 1 ; \
       fi \
    && dnf -y install dnf5-plugins \
    && IMAGE_NAME=lilithos MULTILIB=0 AKMODNV_PATH=/tmp/akmods-rpms \
         bash /tmp/akmods-rpms/ublue-os/nvidia-install.sh \
    && modinfo -k "${KERNEL_VERSION}" nvidia > /dev/null \
    && dnf clean all

# Secure Boot: the public half of the key that signed the module above. With
# Secure Boot on, the kernel only loads modules signed by a key it trusts, so
# the user enrols this certificate once:
#
#     sudo mokutil --import /etc/pki/akmods/certs/akmods-ublue.der
#     (choose a one-time password, reboot, pick "Enroll MOK" on the blue screen)
#
# Without that — or with Secure Boot off — nothing changes from before. The
# build verifies this is really the certificate the module was signed with
# (modinfo's sig_key is the signing certificate's serial number), so a key
# rotation upstream cannot leave us shipping a certificate that enrols nothing.
COPY iso/assets/secureboot/akmods-ublue.der /etc/pki/akmods/certs/akmods-ublue.der
RUN KVER=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-core | tail -1) \
    && SIG=$(modinfo -k "${KVER}" -F sig_key nvidia | tr -d ':' | tr 'a-f' 'A-F') \
    && CERT=$(openssl x509 -inform der -in /etc/pki/akmods/certs/akmods-ublue.der -noout -serial | cut -d= -f2) \
    && if [ -z "${SIG}" ] || [ "${SIG}" != "${CERT}" ]; then \
         echo "ERROR: nvidia.ko is signed by key ${SIG:-<unsigned>}, but the shipped certificate is ${CERT}." ; \
         exit 1 ; \
       fi

# Kernel arguments the driver needs (nvidia-drm.modeset=1 for Wayland, nouveau
# blacklist). bootc applies kargs.d at install and on upgrade, so these reach
# installed machines via `bootc upgrade` rather than only fresh installs.
COPY iso/assets/bootc/kargs.d/10-nvidia.toml /usr/lib/bootc/kargs.d/10-nvidia.toml

# The driver packages enable these units on every machine, but the image runs
# on machines with no NVIDIA module loaded too (VMs, AMD/Intel, Secure Boot
# before the key is enrolled), where they fail loudly on every boot. Gate them
# on the module being present — see the drop-in for the full story.
COPY iso/assets/systemd/system/nvidia-only-with-driver.conf \
     /usr/lib/systemd/system/nvidia-persistenced.service.d/10-lilith-only-with-driver.conf
COPY iso/assets/systemd/system/nvidia-only-with-driver.conf \
     /usr/lib/systemd/system/nvidia-cdi-refresh.service.d/10-lilith-only-with-driver.conf
COPY iso/assets/systemd/system/nvidia-only-with-driver.conf \
     /usr/lib/systemd/system/nvidia-cdi-refresh.path.d/10-lilith-only-with-driver.conf

# Suspend/resume needs nothing from us any more. The driver package installed
# above ships /usr/lib/modprobe.d/nvidia.conf with
# NVreg_PreserveVideoMemoryAllocations=1 (keep VRAM across suspend) and the
# nouveau blacklist, so our own copy of that option was a duplicate, and this
# driver generation no longer ships the nvidia-suspend/-resume/-hibernate
# systemd units we used to enable (it hooks suspend inside the kernel module).
# Resume on real hardware is still to be confirmed after this change — P005.

# Guest-integration daemons for VMs. open-vm-tools (VMware) gives
# host time-sync + guest info; qemu-guest-agent covers QEMU/KVM.
# Both are no-ops on bare metal / a non-matching hypervisor, so
# enabling them unconditionally is safe. The legacy VMware Tools
# ISO installer can't run on a bootc image (/usr is read-only) —
# baking the package in is the correct path. Note: desktop auto-
# resize / clipboard over Wayland is limited (labwc doesn't expose
# the resize protocol VMware's X resizer used); time-sync + the
# "VMware Tools running" status are the practical wins.
RUN systemctl enable vmtoolsd.service qemu-guest-agent.service 2>/dev/null || true

# ── Daily-driver plumbing (ADR 0026) ────────────────────────────────────
# Three gaps that make a desktop actually usable, none present in the base:
#   - Portals: xdg-desktop-portal + the wlroots backend (ScreenCast /
#     Screenshot — so browser screen-share and video calls work) + the GTK
#     backend (FileChooser, Settings, ...; the wlr backend has neither).
#     The PipeWire stack is what the ScreenCast portal streams over.
#   - Removable media: udisks2 (mount engine — Dolphin mounts through it) +
#     udiskie (automount + notify, started from the labwc autostart).
#   - Printing: CUPS + filters + the polkit helper + a printer-admin GUI,
#     and Avahi so driverless (IPP Everywhere) network printers are found
#     automatically (CUPS' dnssd backend queries Avahi directly).
RUN dnf -y install \
        xdg-desktop-portal \
        xdg-desktop-portal-wlr \
        xdg-desktop-portal-gtk \
        pipewire \
        wireplumber \
        pipewire-pulseaudio \
        udisks2 \
        udiskie \
        cups \
        cups-filters \
        cups-pk-helper \
        system-config-printer \
        avahi \
    && dnf clean all

# Route the portal interfaces: ScreenCast/Screenshot to the wlroots backend,
# everything else (FileChooser, Settings, ...) to GTK. Keyed to
# XDG_CURRENT_DESKTOP=labwc (set in iso/assets/labwc/environment).
COPY iso/assets/xdg-desktop-portal/labwc-portals.conf \
     /usr/share/xdg-desktop-portal/labwc-portals.conf

# Socket-activated printing + mDNS discovery. udisks2 and
# xdg-desktop-portal are D-Bus activated (no enable needed).
RUN systemctl enable cups.socket avahi-daemon.service
# PipeWire user units enabled --global so every session gets audio +
# screencast. Guarded: exact unit names vary across releases, and the base
# may already enable them via preset.
RUN systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true

# Flathub remote system-wide so `flatpak install --user flathub <id>`
# resolves on first call. Adding it at image build time keeps the
# first-boot path zero-config — Lilith can install Firefox before
# the user has typed anything else.
RUN flatpak remote-add --if-not-exists flathub \
        https://flathub.org/repo/flathub.flatpakrepo

# Pre-install Firefox so the first boot has a working browser even
# when the user hasn't connected to Wi-Fi yet. Adds ~200 MB to the
# image (Firefox + Freedesktop runtime) but makes "open the browser"
# work out of the box.
#
# --system installs into /var/lib/flatpak which is writable on bootc;
# --no-related skips pre-installing the locale extensions (they'd add
# another ~100 MB without much benefit on a pt-BR default).
# The .desktop file lands in /var/lib/flatpak/exports/share/applications,
# which is already in XDG_DATA_DIRS via iso/assets/launchers/jarvis-
# session-launch — so the launcher grid (Phase 3 polish) picks it up.
RUN flatpak install --system --noninteractive --no-related -y \
        flathub org.mozilla.firefox

# Pre-install Dolphin (KDE file manager). Phase 23 — closes the
# "where are my files?" gap. The user picked KDE's Dolphin over
# Nautilus + others; first install pulls in the KDE Platform
# runtime (~1 GB) which is the costly part. Future KDE apps reuse
# the runtime so they're tiny in comparison.
RUN flatpak install --system --noninteractive --no-related -y \
        flathub org.kde.dolphin

# Pre-install Zed (Rust-based code editor). Reuses the Freedesktop
# runtime Firefox already pulled, so marginal cost is ~150 MB. Same
# ecosystem (Rust) as our own daemons — keeps the "code editor"
# slot coherent with the rest of the stack instead of dragging in
# yet another runtime for a single app.
RUN flatpak install --system --noninteractive --no-related -y \
        flathub dev.zed.Zed

# Daily-driver viewers, all KDE (Qt) so they REUSE the KDE Platform runtime
# Dolphin already pulled — marginal cost is tens of MB each, not another
# runtime. Gwenview (images), Okular (PDF/docs), Haruna (mpv-based media).
# They also inherit the WhiteSur cursor/icon override and will pick up the
# Kvantum theme when that lands (roadmap PR 3).
RUN flatpak install --system --noninteractive --no-related -y \
        flathub org.kde.gwenview org.kde.okular org.kde.haruna

# System-wide MIME defaults — folders open in Dolphin, http(s)/html
# in Firefox. Drops into /etc/xdg/ so every user inherits without
# needing to maintain a per-user mimeapps.list.
COPY iso/assets/xdg/mimeapps.list /etc/xdg/mimeapps.list

# WhiteSur (macOS-like) GTK theme + icons + cursors, system-wide
# under /usr/share. Styles GTK apps (Firefox) + the icon set the
# launcher / file manager read + the pointer. Our own Qt shell keeps
# its glassmorphic design — the GTK theme doesn't touch it.
#
# Dolphin (Qt/KDE) is NOT styled by this — matching it needs the
# WhiteSur Kvantum theme + qt5ct/qt6ct wiring, deferred to a
# follow-up. git is only needed for the clone, so we install it,
# run the script, and the layer keeps the cloned repos out (the
# script cleans its tmp dir).
COPY iso/assets/theme/install-whitesur.sh /tmp/install-whitesur.sh
# git for the clones; sass + glib2 for the GTK4/libadwaita theme
# build (WhiteSur's install.sh compiles gtk4 CSS with sass and runs
# glib-compile-resources). Missing sass is the usual reason the
# install dies mid-run.
#
# The WhiteSur step is NON-FATAL: it's purely cosmetic, so a failure
# (network hiccup, OOM on the huge icon repo, upstream script change)
# logs a warning and ships the ISO without the theme rather than
# killing a 10-minute build. The gtk-settings.ini below names
# WhiteSur-Dark; if the theme is absent GTK silently falls back to
# its default, which is harmless.
RUN dnf -y install git sass glib2 \
    && ( bash /tmp/install-whitesur.sh \
         || echo "WARN: WhiteSur install failed — shipping without the theme" ) \
    && rm -f /tmp/install-whitesur.sh \
    && dnf -y remove git sass \
    && dnf clean all

# System-wide GTK defaults so GTK apps pick up WhiteSur + the icon
# theme + cursor without a per-user config file.
COPY iso/assets/theme/gtk-settings.ini /etc/gtk-3.0/settings.ini
COPY iso/assets/theme/gtk-settings.ini /etc/gtk-4.0/settings.ini

# Flatpak sandboxes don't see /usr/share/themes|icons and reset the
# environment, so the session launcher's GTK_THEME won't reach
# Firefox. A system-wide override grants read-only access to the
# host theme dirs + sets GTK_THEME inside the sandbox. Applies to
# every Flatpak (current + future), so Dolphin/Zed inherit the
# icon + cursor too even though their widget toolkits differ.
#
# The Wayland bits (--socket=wayland + QT_QPA_PLATFORM/GDK_BACKEND/
# MOZ_ENABLE_WAYLAND) force Flatpaks onto Wayland: this session has no
# working XWayland/DISPLAY, so apps that default to X11 fail at launch.
# NOTE: --system overrides live under /var, which bootc only seeds on
# install — an OTA upgrade does NOT refresh them. The session autostart
# re-applies the Wayland part as a --user override each login so existing
# installs get it without a reinstall; this block covers fresh installs.
#
# No writable filesystem access is granted here. Every app used to get
# --filesystem=xdg-download and Firefox --filesystem=home, which let any
# sandboxed app read and rewrite the user's downloads and gave a browser
# exploit the whole home directory. Firefox's manifest already grants it
# Downloads; anything else goes through the file-chooser portal. The two
# host paths below are read-only theme data. (Installs made before this
# change keep the old system-level grants until reinstalled; the user-level
# ones are cleared by the session autostart.)
RUN flatpak override --system \
        --filesystem=/usr/share/themes:ro \
        --filesystem=/usr/share/icons:ro \
        --env=GTK_THEME=WhiteSur-Dark \
        --env=XCURSOR_THEME=WhiteSur-cursors \
        --socket=wayland \
        --env=QT_QPA_PLATFORM=wayland \
        --env=GDK_BACKEND=wayland \
        --env=MOZ_ENABLE_WAYLAND=1

# Nested user namespaces so Flatpak apps with their own inner sandbox
# (Firefox's content process) can start. Without a budget the nested
# clone(CLONE_NEWUSER) fails EPERM and Firefox dies right after launch —
# the dock click appears to do nothing. systemd-sysctl applies this at
# boot; an OTA upgrade + reboot picks it up. See the asset for the full
# rationale.
COPY iso/assets/sysctl/99-jarvis-userns.conf /usr/lib/sysctl.d/99-jarvis-userns.conf

# Ollama. The upstream installer creates a system user with home
# `/usr/share/ollama`, which is read-only under bootc — the daemon then
# crash-loops trying to write `~/.ollama/id_ed25519`. We bolt on a drop-in
# that redirects HOME to /var/lib/ollama and asks systemd to provision that
# directory with the right ownership (StateDirectory= creates
# /var/lib/<name> chown ollama:ollama before ExecStart). We also enable the
# unit — the installer skips `systemctl enable` on bootc images.
RUN curl -fsSL https://ollama.com/install.sh | sh \
    && mkdir -p /etc/systemd/system/ollama.service.d \
    && printf '[Service]\nEnvironment=HOME=/var/lib/ollama\nStateDirectory=ollama\n' \
        > /etc/systemd/system/ollama.service.d/bootc-home.conf \
    && systemctl enable ollama.service

LABEL org.opencontainers.image.title="LilithOS runtime base"
LABEL org.opencontainers.image.description="fedora-bootc 42 + desktop runtime + Flatpak apps + WhiteSur + Ollama, prebuilt for fast image builds"
