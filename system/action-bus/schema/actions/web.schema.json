{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-os.dev/schema/action-bus/actions/web",
  "title": "Web Actions",
  "description": "Action schemas for the web.* namespace",
  "oneOf": [
    {
      "title": "web.search",
      "description": "Search the web and return the top results",
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "description": "The search query" },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Max results to return (default 5)"
        }
      }
    },
    {
      "title": "web.fetch",
      "description": "Fetch a web page and return its readable text",
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "description": "http(s) URL to fetch" },
        "max_chars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 20000,
          "description": "Truncate the returned text to this many characters (default 4000)"
        }
      }
    }
  ]
}
